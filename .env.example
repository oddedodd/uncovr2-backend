APP_NAME=Uncovr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PORTAL_URL=http://localhost:3000
TRUSTED_HOSTS=localhost

CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SANCTUM_TOKEN_PREFIX=uncovr_
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_IDLE_TTL_DAYS=30
AUTH_MOBILE_SESSION_ABSOLUTE_TTL_DAYS=90
AUTH_PORTAL_SESSION_ABSOLUTE_TTL_MINUTES=720
AUTH_REFRESH_TOKEN_RETENTION_DAYS=30
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=60
AUTH_PASSWORD_RESET_TTL_MINUTES=60
AUTH_PASSWORD_RESET_THROTTLE_SECONDS=60
ORGANIZATION_INVITATION_TTL_HOURS=72

RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120
RATE_LIMIT_AUTHENTICATION_PER_IP_PER_MINUTE=10
RATE_LIMIT_AUTHENTICATION_PER_IDENTITY_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_IP_PER_MINUTE=30
RATE_LIMIT_REFRESH_PER_TOKEN_PER_MINUTE=10
RATE_LIMIT_WEBHOOKS_PER_MINUTE=300

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
OPERATIONS_ALERT_CHANNEL=stack
OPERATIONS_MONITOR_WINDOW_MINUTES=60
OPERATIONS_MINIMUM_EMAIL_VOLUME=20
OPERATIONS_MAX_PROVIDER_FAILURES=3
OPERATIONS_MAX_QUEUE_FAILURES=0
OPERATIONS_MAX_BOUNCE_RATE=0.05
OPERATIONS_MAX_COMPLAINT_RATE=0.001
OPERATIONS_ALERT_COOLDOWN_MINUTES=60

DB_CONNECTION=pgsql
DB_URL=
DB_SCHEMA=laravel
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=pgsql
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=180
QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_WORKER_QUEUES=emails,publishing,default
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_TIMEOUT=120
QUEUE_WORKER_MAX_TIME=3600
QUEUE_WORKER_MEMORY=256
QUEUE_MONITOR_MAX_JOBS=100
QUEUE_FAILED_RETENTION_HOURS=720
QUEUE_BATCH_RETENTION_HOURS=168
PUBLISHING_QUEUE=publishing

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="accounts@mail.uncovr.no"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="support@uncovr.no"
MAIL_REPLY_TO_NAME="${APP_NAME} support"
MAIL_QUEUE=emails
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_URL=
RESEND_WEBHOOK_TOLERANCE_SECONDS=300
RESEND_WEBHOOK_MAX_PAYLOAD_BYTES=65536
RESEND_API_KEY_ROTATED_AT=
RESEND_WEBHOOK_SECRET_ROTATED_AT=
RESEND_CREDENTIAL_MAX_AGE_DAYS=90

# Backend-only Supabase Storage credentials. Never expose the secret key to clients.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_PRIVATE_BUCKET=uncovr-private-media
SUPABASE_STORAGE_PUBLIC_BUCKET=uncovr-public-media
MEDIA_DOWNLOAD_TTL_SECONDS=900
MEDIA_TEMPORARY_RETENTION_HOURS=24
MEDIA_SUPERSEDED_RETENTION_DAYS=7

# Server-owned legal-document versions and the account-deletion grace period.
PRIVACY_TERMS_VERSION=2026-08-09
PRIVACY_POLICY_VERSION=2026-08-09
PRIVACY_DELETION_GRACE_DAYS=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
